# Optional GitHub API credential; leave empty for public sample/offline use.
GITHUB_TOKEN=

# Optional Gemini provider settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ALTERNATE_MODELS=

# Optional OpenAI provider settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ALTERNATE_MODELS=

# Shared provider-attempt budget (allowed range: 1-10).
LLM_MAX_PROVIDER_ATTEMPTS=3
